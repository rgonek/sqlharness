{
  "prod-eu": {
    "server": "contoso.database.windows.net",
    "database": "contoso-{tenant}-{env}",
    "vars": {
      "tenant": "^[a-z0-9]{3,20}$",
      "env": "^(dev|test|uat)$"
    },
    "auth": "ad-default"
  },
  "local-pg": {
    "engine": "postgres",
    "server": "localhost,5433",
    "database": "pagila",
    "vars": {},
    "auth": "sql",
    "sqlUser": "postgres",
    "passwordEnvVar": "SQLHARNESS_PG_PLAYGROUND_PASSWORD",
    "trustServerCertificate": true
  },
  "remote-pg": {
    "engine": "postgres",
    "server": "db.example.test,5432",
    "database": "appdb",
    "vars": {},
    "auth": "sql",
    "sqlUser": "sqlharness",
    "passwordEnvVar": "SQLHARNESS_PG_PASSWORD",
    "trustServerCertificate": false,
    "sslMode": "verify-full"
  }
}
