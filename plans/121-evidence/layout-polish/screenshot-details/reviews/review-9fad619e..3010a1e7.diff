@@ -0,0 +1,33 @@
+import { expect, test } from "vitest"
+import { inlineMutationSql } from "./sqlDisplay"
+const p = (name: string, value: string | null, type: string | null = null) => ({ name, value, type })
+test("SQL Server lexical boundaries and precision", () => {
+  const result = inlineMutationSql("SELECT @@ROWCOUNT, @A, @ab, [@a], '@a' /* outer /* @a */ @ab */ -- @a", "sqlserver", [p("a", "O'Brien"), p("ab", "9007199254740993", "bigint")])
+  for (const text of ["N'O''Brien'", "9007199254740993", "@@ROWCOUNT", "[@a]", "'@a'", "/* outer /* @a */ @ab */"]) expect(result.sql).toContain(text)
+  expect(result.reason).toBeUndefined()
+})
+test("PostgreSQL dollar quotes, comments, operators and empty text", () => {
+  const result = inlineMutationSql("SELECT @a, $$@a$$, $body$@a$body$, '@a', x @> y -- @a", "postgres", [p("a", "")])
+  for (const text of ["''", "$$@a$$", "$body$@a$body$", "x @> y"]) expect(result.sql).toContain(text)
+  expect(result.reason).toBeUndefined()
+})
+test("unsupported, missing, duplicate, ambiguous and huge inputs retain exact original", () => {
+  for (const params of [[p("a", "1", "geography")], [], [p("a", "1"), p("A", "2")], [p("a", "a\\b")]]) {
+    const result = inlineMutationSql("SELECT @a", "postgres", params)
+    expect(result.reason).toBeTruthy()
+    expect(result.sql).toBe("SELECT @a")
+  }
+  expect(inlineMutationSql("x".repeat(100001), "postgres", []).reason).toBeTruthy()
+})
+test("null is NULL and default numeric-looking text stays text", () => {
+  const result = inlineMutationSql("SELECT @a,@b,@c", "sqlserver", [p("a", null), p("b", "123"), p("c", "false", "bit")])
+  expect(result.sql).toContain("NULL")
+  expect(result.sql).toContain("N'123'")
+  expect(result.sql).toMatch(/\b0\b/)
+})
+
+test("normalizes contract engine and parameter prefix without changing tokens", () => {
+  const result = inlineMutationSql("SELECT @a, @ab", "SqlServer", [p("@a", "1", "int"), p("ab", "2", "int")])
+  expect(result.reason).toBeUndefined()
+  expect(result.sql).not.toContain("@a")
+})
diff --git a/src/SqlHarness.Dashboard/ui/src/mutations/sqlDisplay.ts b/src/SqlHarness.Dashboard/ui/src/mutations/sqlDisplay.ts
new file mode 100644
index 00000000..237823bb
--- /dev/null
+++ b/src/SqlHarness.Dashboard/ui/src/mutations/sqlDisplay.ts
@@ -0,0 +1,45 @@
+import { format } from "sql-formatter"
+import type { MutationParameter } from "./mutationStore"
+
+/** Presentation only; never used to submit a decision or execute SQL. */
+export function inlineMutationSql(sql: string, engine: string, parameters: MutationParameter[]): { sql: string; reason?: string } {
+  const fallback = () => ({ sql, reason: "Values inline is unavailable for this SQL or parameter type. As sent shows the original request." })
+  if (sql.length > 100_000 || parameters.length > 500 || parameters.reduce((n, p) => n + (p.value?.length ?? 0), 0) > 100_000) return fallback()
+  engine = engine.toLowerCase()
+  const postgres = engine === "postgres"
+  if (!postgres && engine !== "sqlserver") return fallback()
+  try {
+    const values = new Map<string, string>()
+    for (const parameter of parameters) {
+      const name = parameter.name.replace(/^@/, "").toLowerCase()
+      if (!/^[a-z_][a-z0-9_]*$/i.test(name) || values.has(name)) return fallback()
+      const type = (parameter.type || "nvarchar").toLowerCase()
+      const value = parameter.value
+      let literal: string
+      if (value === null) literal = "NULL"
+      else if (/^(nvarchar|varchar|nchar|char)(\((max|\d+)\))?$/.test(type)) {
+        if (postgres && value.includes("\\")) return fallback()
+        literal = `${!postgres && type.startsWith("n") ? "N" : ""}'${value.replaceAll("'", "''")}'`
+      } else if (/^(tinyint|smallint|int|bigint)$/.test(type) && /^[+-]?\d+$/.test(value)) {
+        const ranges: Record<string, [bigint, bigint]> = { tinyint: [0n, 255n], smallint: [-32768n, 32767n], int: [-2147483648n, 2147483647n], bigint: [-9223372036854775808n, 9223372036854775807n] }
+        const [min, max] = ranges[type]
+        if (BigInt(value) < min || BigInt(value) > max) return fallback()
+        literal = value
+      }
+      else if (/^(decimal|numeric)(\(\d+,\d+\))?$/.test(type) && /^[+-]?\d+(\.\d+)?$/.test(value)) {
+        // .NET decimal binding can round beyond its precision.
+        if (value.replace(/[^0-9]/g, "").length > 28) return fallback()
+        literal = value
+      }
+      else if (type === "bit" && /^(true|false|0|1)$/i.test(value)) literal = postgres ? (/^(true|1)$/i.test(value) ? "TRUE" : "FALSE") : (/^(true|1)$/i.test(value) ? "1" : "0")
+      else return fallback()
+      values.set(name, literal)
+    }
+    const params = new Proxy(Object.create(null) as Record<string, string>, { get: (_target, key) => {
+      const value = typeof key === "string" ? values.get(key.toLowerCase()) : undefined
+      if (value === undefined) throw new Error("Unresolved SQL parameter")
+      return value
+    } })
+    return { sql: format(sql, { language: postgres ? "postgresql" : "transactsql", params, paramTypes: { named: ["@"] } }) }
+  } catch { return fallback() }
+}
